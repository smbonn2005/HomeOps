{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":timezone(America/New_York)",
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process annotated kustomize release assets, whose URLs the bundled annotation manager cannot match",
      "managerFilePatterns": ["/(^|/)kustomization\\.ya?ml$/"],
      "matchStrings": [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[^\\n]*\\n[^\\n]*?/releases/download/(?<currentValue>v?[^/]+)/"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Track the crd-extractor commit the schemas workflow pulls",
      "managerFilePatterns": ["/^\\.github/workflows/schemas\\.yaml$/"],
      "matchStrings": ["datreeio/CRDs-catalog/(?<currentDigest>[0-9a-f]{40})/"],
      "currentValueTemplate": "main",
      "depNameTemplate": "datreeio/CRDs-catalog",
      "packageNameTemplate": "https://github.com/datreeio/CRDs-catalog",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    // Versioning rules
    {
      "description": "LinuxServer.io tags carry a per-build -lsNNN suffix that docker versioning reads as an incompatible variant",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/bookstack"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-ls(?<build>\\d+)$"
    },
    // Allowed version rules
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/postgresql/"],
      "allowedVersions": "<17"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/mysql/"],
      "allowedVersions": "<9"
    },
    // Auto-merge rules
    {
      "description": "Auto-merge trusted OCI digests",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["/home-operations/"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Auto-merge high-cadence OCI packages weekly",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["/kube-prometheus-stack/"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
      "schedule": ["before 6am on Monday"]
    },
    {
      "description": "Auto-merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "3 days",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge trusted GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/^actions\\//", "/^renovatebot\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch",
      "minimumReleaseAge": "1 minute",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge Grafana dashboards",
      "matchDatasources": ["custom.grafana-dashboards"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge Renovate Presents",
      "matchManagers": ["renovate-config"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    // Grouping rules
    {
      "description": "Actions Runner Controller Group",
      "groupName": "actions-runner-controller",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "Flux Operator Group",
      "groupName": "flux-operator",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/flux-operator/", "/flux-instance/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "Kubernetes Group",
      "groupName": "kubernetes",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/"
      ],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 5
    },
    {
      "description": "Rook-Ceph Group",
      "groupName": "rook-ceph",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/rook-ceph/", "/rook-ceph-cluster/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    // Labeling rules
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["type/major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "addLabels": ["type/minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "addLabels": ["type/patch"]
    },
    {
      "matchUpdateTypes": ["digest"],
      "addLabels": ["type/digest"]
    }
  ]
}
